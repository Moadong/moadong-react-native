require "fileutils"
require "base64"
require "json"

default_platform(:android)

PROJECT_ROOT = File.expand_path("..", __dir__)

def project_path(*parts)
  File.join(PROJECT_ROOT, *parts)
end

def expand_project_path(path)
  File.absolute_path(path, PROJECT_ROOT)
end

def require_file!(path, label)
  UI.user_error!("#{label} is missing: #{path}") unless path && File.exist?(path)
end

def require_json_file!(path, label)
  require_file!(path, label)
  JSON.parse(File.read(path))
rescue JSON::ParserError => error
  UI.user_error!("#{label} is not valid JSON: #{path} (#{error.message})")
end

def require_env!(name)
  value = ENV[name]
  UI.user_error!("Missing required environment variable: #{name}") if value.to_s.empty?
  value
end

def restore_file_from_env(path, env_name, label, base64: false)
  return if path.to_s.empty? || File.exist?(path)

  value = ENV[env_name]
  return if value.to_s.empty?

  content = base64 ? Base64.strict_decode64(value.delete(" \n\r\t")) : value
  UI.user_error!("#{label} from #{env_name} is empty") if content.empty?

  FileUtils.mkdir_p(File.dirname(path))
  File.binwrite(path, content)
rescue ArgumentError => error
  UI.user_error!("#{label} from #{env_name} is not valid base64: #{error.message}")
end

def upsert_gradle_properties(path, values)
  lines = File.exist?(path) ? File.readlines(path, chomp: true) : []
  keys = values.keys
  filtered_lines = lines.reject do |line|
    key = line.split("=", 2).first
    keys.include?(key)
  end

  File.write(path, (filtered_lines + values.map { |key, value| "#{key}=#{value}" }).join("\n") + "\n")
end

def build_android_release_aab
  json_key = expand_project_path(require_env!("SUPPLY_JSON_KEY"))
  keystore_name = ENV.fetch("MYAPP_UPLOAD_STORE_FILE", "moadong-upload.keystore")
  keystore_path = expand_project_path(keystore_name)
  google_services_path = project_path("google-services.json")

  restore_file_from_env(google_services_path, "GOOGLE_SERVICES_JSON_BASE64", "Android Firebase config", base64: true)
  restore_file_from_env(json_key, "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON", "Google Play service account JSON", base64: true)
  restore_file_from_env(keystore_path, "ANDROID_KEYSTORE_BASE64", "Android upload keystore", base64: true)

  require_json_file!(json_key, "Google Play service account JSON")
  require_file!(google_services_path, "Android Firebase config")
  require_file!(keystore_path, "Android upload keystore")

  store_password = require_env!("MYAPP_UPLOAD_STORE_PASSWORD")
  key_alias = require_env!("MYAPP_UPLOAD_KEY_ALIAS")
  key_password = require_env!("MYAPP_UPLOAD_KEY_PASSWORD")

  Dir.chdir(PROJECT_ROOT) do
    sh("CI=1 npx expo prebuild --platform android --clean")
  end

  android_app_keystore = project_path("android", "app", File.basename(keystore_name))
  FileUtils.cp(keystore_path, android_app_keystore)

  upsert_gradle_properties(
    project_path("android", "gradle.properties"),
    {
      "MYAPP_UPLOAD_STORE_FILE" => File.basename(keystore_name),
      "MYAPP_UPLOAD_STORE_PASSWORD" => store_password,
      "MYAPP_UPLOAD_KEY_ALIAS" => key_alias,
      "MYAPP_UPLOAD_KEY_PASSWORD" => key_password,
    }
  )

  Dir.chdir(project_path("android")) do
    sh("./gradlew bundleRelease")
  end

  project_path("android", "app", "build", "outputs", "bundle", "release", "app-release.aab")
end

platform :android do
  desc "Build and upload the Android release AAB to Google Play internal testing"
  lane :internal do
    package_name = ENV.fetch("ANDROID_PACKAGE_NAME", "com.moadong.moadong")
    json_key = expand_project_path(require_env!("SUPPLY_JSON_KEY"))
    aab_path = build_android_release_aab

    upload_to_play_store(
      package_name: package_name,
      json_key: json_key,
      track: "internal",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Build and upload the Android release AAB as a draft production release"
  lane :production_draft do
    package_name = ENV.fetch("ANDROID_PACKAGE_NAME", "com.moadong.moadong")
    json_key = expand_project_path(require_env!("SUPPLY_JSON_KEY"))
    aab_path = build_android_release_aab

    upload_to_play_store(
      package_name: package_name,
      json_key: json_key,
      track: "production",
      release_status: "draft",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
